# Notion의 내부 통합(Integration) 시크릿
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# "민수 공기업 취업 준비 (2026)" 페이지 ID
NOTION_PARENT_PAGE_ID=3ab2ca19708981028316c7c8195a7d0e

# 기존 "지원 현황" 데이터 소스 ID (체크한 ALIO 공고를 지원 현황으로 복사)
NOTION_APPLICATION_DATA_SOURCE_ID=f4a18d21-e460-443b-9545-538ffddbd384

# "관심 전형 일정" 데이터 소스 ID (관심 체크한 공고의 전형 단계를 캘린더로 관리)
NOTION_SCHEDULE_DATA_SOURCE_ID=0811a98f-88c7-41df-818d-95cb048ccf66

TELEGRAM_BOT_TOKEN=123456789:replace_with_botfather_token
TELEGRAM_CHAT_ID=123456789
DATABASE_PATH=data/alio_olio.db
TIMEZONE=Asia/Seoul

# 동기화 시각(cron 시간 필드). 기본 7-19 = 아침 7시부터 저녁 7시까지 매시 정각.
# 알림은 동기화할 때만 나가므로 이 값이 곧 텔레그램이 오는 시간대다.
SYNC_HOURS=7-19
# 노션 필터를 고쳤을 때 반영되는 주기(분)
FILTER_REFRESH_MINUTES=15
